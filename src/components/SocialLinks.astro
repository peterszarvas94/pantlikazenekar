---
import Icon from "../icons/Icon.astro";

interface Props { lang?: "hu" | "en"; labeled?: boolean; }
const { lang = "hu", labeled = false } = Astro.props;
const en = lang === "en";
const englishLabels = [
  "Open Facebook page in a new window",
  "Open Instagram profile in a new window",
  "Open YouTube playlist in a new window",
  "Email the band",
  "Call the band",
];

const links = [
  { icon: "facebook", href: "https://www.facebook.com/pantlikazenekar/", title: "Facebook", label: "Facebook oldal megnyitása új ablakban", external: true },
  { icon: "instagram", href: "https://www.instagram.com/pantlikatamburazenekar/", title: "Instagram", label: "Instagram profil megnyitása új ablakban", external: true },
  { icon: "youtube", href: "https://www.youtube.com/playlist?list=PLK2TbLF0FDt9YC-9f2SIh6tZa59ygKvMy", title: "YouTube", label: "YouTube lejátszási lista megnyitása új ablakban", external: true },
  { icon: "mail", href: "mailto:pantlikazenekar@gmail.com", title: "Email", label: "Email küldése a zenekarnak", external: false },
  { icon: "phone", href: "tel:+36707785049", title: "Telefon", label: "Telefonhívás indítása", external: false },
] as const;
---

<nav aria-label={en ? "Social media and contact links" : "Közösségi média linkek"}>
  <ul class={labeled ? "contact_links" : "social_links"} role="list">
    {
      (labeled ? [...links.filter(link => !link.external), ...links.filter(link => link.external)] : links).map((link) => (
        <li class:list={{ direct: labeled && !link.external }}>
          <a
            href={link.href}
            title={en && link.icon === "phone" ? "Phone" : link.title}
            aria-label={labeled ? undefined : en ? englishLabels[links.indexOf(link)] : link.label}
            {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            <Icon name={link.icon} size={22} />
            {labeled && <span>{link.icon === "mail" ? "pantlikazenekar@gmail.com" : link.icon === "phone" ? "+36 70 778 5049" : link.title}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .contact_links { display: flex; flex-wrap: wrap; justify-content: center; column-gap: 1.25rem; row-gap: 0.25rem; list-style: none; padding: 0; margin: 0 auto; max-width: 100%; }
  .contact_links .direct { display: flex; justify-content: center; width: 100%; }
  .contact_links .direct a { font-size: 1.15rem; }
  .contact_links .direct:nth-child(2) { margin-bottom: 1rem; }
  .contact_links li:not(.direct) { font-size: 0.9rem; color: var(--ink-soft); }
  .contact_links a { display: flex; align-items: center; gap: 0.75rem; min-height: 2.75rem; color: inherit; text-decoration: none; }
  .contact_links a:hover, .contact_links a:focus-visible { color: var(--red); }
  .contact_links span { overflow-wrap: anywhere; min-width: 0; text-decoration: underline; text-decoration-color: rgb(59 20 20 / 0.25); text-underline-offset: 0.2em; transition: text-decoration-color 0.15s; }
  .contact_links a:hover span, .contact_links a:focus-visible span { text-decoration-color: rgb(182 3 2 / 0.45); }
  .contact_links :global(svg) { flex-shrink: 0; }
</style>
