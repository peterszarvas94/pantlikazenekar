---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Icon from "../icons/Icon.astro";

interface Props {
  id: string;
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
}

const { id, src, alt, widths, sizes } = Astro.props;
const popoverId = `photo-${id}`;
---

<button class="photo-link" type="button" popovertarget={popoverId} aria-label={`${alt} (nagyobb méretben)`}>
  <Image class="photo" src={src} alt={alt} widths={widths} sizes={sizes} />
</button>
<div id={popoverId} class="lightbox" popover>
  <img class="lightbox_img" src={src.src} alt={alt} width={src.width} height={src.height} loading="lazy" decoding="async" />
  <button class="lightbox_close" type="button" popovertarget={popoverId} popovertargetaction="hide" aria-label="Bezárás">
    <Icon name="x" size={22} />
  </button>
</div>
